  class TeardownSimulator {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private dpr: number = 1;

    // 3D Camera & Pose State
    private pitch: number = 0.55;   // ~32 degrees tilt
    private yaw: number = 0.55;     // ~32 degrees orbit
    private targetPitch: number = 0.55;
    private targetYaw: number = 0.55;
    private fov: number = 650;
    private zoom: number = 1.0;
    private targetZoom: number = 1.0;

    // Teardown / Explode State
    private explodeProgress: number = 0.50; // 0..1
    private targetExplodeProgress: number = 0.50;

    // Subsystem Isolation
    private isolatedLayer: number | null = null; // null = all layers

    // Auto Tour
    private isTouring: boolean = false;
    private tourStep: number = 0;
    private tourTimer: number | null = null;
    private lastInteractionTime: number = Date.now();

    // Mouse Drag State
    private isDragging: boolean = false;
    private lastMouseX: number = 0;
    private lastMouseY: number = 0;

    // Animation Loop
    private animFrameId: number | null = null;
    private lastFrameTime: number = performance.now();

    constructor() {
      const c = document.getElementById('teardown-canvas') as HTMLCanvasElement;
      if (!c) throw new Error('Teardown canvas not found');
      this.canvas = c;
      const context = c.getContext('2d');
      if (!context) throw new Error('Canvas 2D context not available');
      this.ctx = context;

      this.resize();
      window.addEventListener('resize', () => this.resize());

      this.initInteractions();
      this.initUIControls();
      this.startLoop();

      // Initial telemetry sync
      this.updateTelemetry(1);
    }

    private resize(): void {
      const parent = this.canvas.parentElement;
      if (!parent) return;
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = parent.getBoundingClientRect();
      const w = Math.floor(rect.width);
      const h = Math.floor(rect.height || 540);

      this.canvas.width = w * this.dpr;
      this.canvas.height = h * this.dpr;
      this.canvas.style.width = `${w}px`;
      this.canvas.style.height = `${h}px`;
    }

    private initInteractions(): void {
      const cvs = this.canvas;
      const viewport = document.getElementById('sim-viewport');

      // Drag Orbit on Canvas
      cvs.addEventListener('pointerdown', (e) => {
        this.isDragging = true;
        this.lastMouseX = e.clientX;
        this.lastMouseY = e.clientY;
        this.lastInteractionTime = Date.now();
        if (this.isTouring) this.stopAutoTour();
        cvs.setPointerCapture(e.pointerId);
      });

      cvs.addEventListener('pointermove', (e) => {
        if (!this.isDragging) return;
        const dx = e.clientX - this.lastMouseX;
        const dy = e.clientY - this.lastMouseY;
        this.lastMouseX = e.clientX;
        this.lastMouseY = e.clientY;
        this.lastInteractionTime = Date.now();

        // Natural object-grab swipe direction (inverted to match intuitive physical manipulation)
        this.targetYaw -= dx * 0.007;
        this.targetPitch = Math.max(-Math.PI * 0.48, Math.min(Math.PI * 0.48, this.targetPitch - dy * 0.007));
      });

      const stopDrag = () => {
        this.isDragging = false;
      };
      cvs.addEventListener('pointerup', stopDrag);
      cvs.addEventListener('pointercancel', stopDrag);

      // Highly Responsive Wheel Zoom on Viewport Container (Cross-Browser Normalized)
      const handleWheel = (e: WheelEvent) => {
        e.preventDefault();
        this.lastInteractionTime = Date.now();
        if (this.isTouring) this.stopAutoTour();

        // Normalize delta across all browser engines (DOM_DELTA_PIXEL, DOM_DELTA_LINE, DOM_DELTA_PAGE)
        const rawDelta = e.deltaMode === 1 ? e.deltaY * 30 : (e.deltaMode === 2 ? e.deltaY * 300 : e.deltaY);
        const sign = Math.sign(rawDelta);
        // Guarantee clear perceptible step per wheel notch (at least +/- 0.08 per tick)
        const step = Math.max(0.08, Math.min(0.24, Math.abs(rawDelta) * 0.0025));
        const zoomDelta = -sign * step;

        this.targetZoom = Math.max(0.35, Math.min(3.5, this.targetZoom + zoomDelta));
      };

      viewport?.addEventListener('wheel', handleWheel, { passive: false });
      cvs.addEventListener('wheel', handleWheel, { passive: false });
    }

    private initUIControls(): void {
      // Explode Slider
      const slider = document.getElementById('explode-slider') as HTMLInputElement | null;
      const sliderText = document.getElementById('explode-percent-text');
      slider?.addEventListener('input', () => {
        this.lastInteractionTime = Date.now();
        if (this.isTouring) this.stopAutoTour();
        const val = parseInt(slider.value, 10);
        this.targetExplodeProgress = val / 100;
        if (sliderText) sliderText.textContent = `${val}%`;
      });

      // Quick Explode Buttons
      const quickBtns = document.querySelectorAll('.quick-btn');
      quickBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.lastInteractionTime = Date.now();
          if (this.isTouring) this.stopAutoTour();
          quickBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const val = parseInt(btn.getAttribute('data-val') || '50', 10);
          this.targetExplodeProgress = val / 100;
          if (slider) slider.value = String(val);
          if (sliderText) sliderText.textContent = `${val}%`;
        });
      });

      // Camera Presets
      const camBtns = document.querySelectorAll('.cam-btn:not(.reset)');
      camBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.lastInteractionTime = Date.now();
          if (this.isTouring) this.stopAutoTour();
          camBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const cam = btn.getAttribute('data-cam');
          this.applyCameraPreset(cam);
        });
      });

      // Reset Cam Button
      document.getElementById('sim-reset-cam-btn')?.addEventListener('click', () => {
        this.applyCameraPreset('isometric');
        this.targetZoom = 1.0;
      });

      // Zoom In / Out / Reset Buttons
      document.getElementById('zoom-in-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.lastInteractionTime = Date.now();
        this.targetZoom = Math.min(3.5, this.targetZoom + 0.22);
      });

      document.getElementById('zoom-out-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.lastInteractionTime = Date.now();
        this.targetZoom = Math.max(0.35, this.targetZoom - 0.22);
      });

      document.getElementById('zoom-reset-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.lastInteractionTime = Date.now();
        this.targetZoom = 1.0;
      });

      // Prominent All 9 Layers Selector Tabs
      const layerTabs = document.querySelectorAll('.layer-tab-btn');
      const allBtn = document.getElementById('isolate-all-btn');

      layerTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.lastInteractionTime = Date.now();
          if (this.isTouring) this.stopAutoTour();
          layerTabs.forEach(b => b.classList.remove('active'));
          allBtn?.classList.remove('active');
          btn.classList.add('active');

          const lId = parseInt(btn.getAttribute('data-layer') || '1', 10);
          this.isolatedLayer = lId;
          this.updateTelemetry(lId);
        });
      });

      allBtn?.addEventListener('click', () => {
        this.lastInteractionTime = Date.now();
        layerTabs.forEach(b => b.classList.remove('active'));
        allBtn.classList.add('active');
        this.isolatedLayer = null;
        this.updateTelemetry(1);
      });

      // Auto Tour Start / Stop
      document.getElementById('start-tour-btn')?.addEventListener('click', () => {
        this.startAutoTour();
      });

      document.getElementById('stop-tour-btn')?.addEventListener('click', () => {
        this.stopAutoTour();
      });
    }

    private applyCameraPreset(preset: string | null): void {
      const modeTag = document.getElementById('view-mode-tag');
      if (preset === 'top-plan') {
        // Direct overhead top view (pitch ~ 0.08, looking straight down at all 9 tiers)
        this.targetPitch = 0.08;
        this.targetYaw = 0.0;
        this.targetZoom = 0.98;
        if (modeTag) modeTag.textContent = 'Top View (Overhead Plan)';
      } else if (preset === 'top-side') {
        // 3D perspective from Top Side (North): standing at the North looking across the tiers
        this.targetPitch = 0.58;
        this.targetYaw = Math.PI; // 180 deg around model
        this.targetZoom = 0.96;
        if (modeTag) modeTag.textContent = '3D Top-Side View (North)';
      } else if (preset === 'bottom-side') {
        // 3D perspective from Bottom Side (South): standing at the South looking across the tiers
        this.targetPitch = 0.58;
        this.targetYaw = 0.0;
        this.targetZoom = 0.96;
        if (modeTag) modeTag.textContent = '3D Bottom-Side View (South)';
      } else if (preset === 'isometric') {
        // Classic 3D Isometric 3/4 perspective
        this.targetPitch = 0.55;
        this.targetYaw = 0.55;
        this.targetZoom = 0.96;
        if (modeTag) modeTag.textContent = '3D Meru Isometric';
      } else if (preset === 'cutaway') {
        // Pure side profile elevation showing vertical stepped Meru temple spacing
        this.targetPitch = 1.42;
        this.targetYaw = Math.PI * 0.5; // Exactly 90 deg side elevation
        this.targetZoom = 1.0;
        if (modeTag) modeTag.textContent = 'Side Profile Elevation';
      } else if (preset === 'bindu') {
        // Macro zoom into the summit Bindu singularity
        this.targetPitch = 0.35;
        this.targetYaw = 0.20;
        this.targetZoom = 1.55;
        if (modeTag) modeTag.textContent = 'Apex Bindu Focus';
      }
    }

    public startAutoTour(): void {
      this.isTouring = true;
      this.tourStep = 0;
      const statusEl = document.getElementById('tour-status');
      if (statusEl) statusEl.style.display = 'flex';

      this.stepTour();
    }

    public stopAutoTour(): void {
      this.isTouring = false;
      if (this.tourTimer) {
        clearTimeout(this.tourTimer);
        this.tourTimer = null;
      }
      const statusEl = document.getElementById('tour-status');
      if (statusEl) statusEl.style.display = 'none';
    }

    private stepTour(): void {
      if (!this.isTouring) return;

      const layerIndex = (this.tourStep % 9) + 1;
      this.isolatedLayer = layerIndex;
      this.updateTelemetry(layerIndex);

      // Highlight corresponding layer button in UI
      const layerTabs = document.querySelectorAll('.layer-tab-btn');
      const allBtn = document.getElementById('isolate-all-btn');
      allBtn?.classList.remove('active');
      layerTabs.forEach(btn => {
        const id = parseInt(btn.getAttribute('data-layer') || '0', 10);
        btn.classList.toggle('active', id === layerIndex);
      });

      const tourText = document.getElementById('tour-status-text');
      if (tourText) {
        tourText.textContent = `Auto Tour: Layer ${layerIndex} of 9 (${LAYERS[layerIndex - 1].title})`;
      }

      // Dynamic camera perspectives covering all planes throughout the tour
      if (layerIndex <= 2) {
        // Layers 1-2: Viewed from Isometric 3D
        this.targetPitch = 0.55;
        this.targetYaw = 0.45;
      } else if (layerIndex <= 4) {
        // Layers 3-4: Viewed from Bottom-Side (South)
        this.targetPitch = 0.60;
        this.targetYaw = 0.0;
      } else if (layerIndex <= 6) {
        // Layers 5-6: Viewed from Side Elevation profile
        this.targetPitch = 1.35;
        this.targetYaw = Math.PI * 0.5;
      } else if (layerIndex <= 8) {
        // Layers 7-8: Viewed from Top-Side (North) looking across all planes
        this.targetPitch = 0.58;
        this.targetYaw = Math.PI;
      } else {
        // Layer 9: Overhead Top View (Plan) zoom into apex Bindu
        this.targetPitch = 0.08;
        this.targetYaw = 0.0;
      }
      this.targetZoom = 0.92 + (layerIndex / 9) * 0.35;
      this.targetExplodeProgress = 0.60;

      this.tourStep++;
      this.tourTimer = window.setTimeout(() => {
        this.stepTour();
      }, 3400);
    }

    private updateTelemetry(layerId: number): void {
      const data = LAYERS.find(l => l.id === layerId) || LAYERS[0];
      const indexEl = document.getElementById('tel-index');
      const sansEl = document.getElementById('tel-sanskrit');
      const titleEl = document.getElementById('tel-title');
      const meanEl = document.getElementById('tel-meaning');
      const chakraEl = document.getElementById('tel-chakra');
      const elemEl = document.getElementById('tel-element');
      const deityEl = document.getElementById('tel-deity');
      const geomEl = document.getElementById('tel-geometry');
      const mudraEl = document.getElementById('tel-mudra');
      const bijaEl = document.getElementById('tel-bija');
      const descEl = document.getElementById('tel-desc');

      if (indexEl) indexEl.textContent = `AVARANA 0${data.id} / 09`;
      if (sansEl) sansEl.textContent = data.sanskrit;
      if (titleEl) titleEl.textContent = data.title;
      if (meanEl) meanEl.textContent = data.meaning;
      if (chakraEl) chakraEl.textContent = data.chakra;
      if (elemEl) elemEl.textContent = data.element;
      if (deityEl) deityEl.textContent = data.deity;
      if (geomEl) geomEl.textContent = data.geometry;
      if (mudraEl) mudraEl.textContent = data.mudra;
      if (bijaEl) bijaEl.textContent = data.bija;
      if (descEl) descEl.textContent = data.desc;
    }

    private startLoop(): void {
      const loop = (time: number) => {
        if (time < this.lastFrameTime) this.lastFrameTime = time;
        this.lastFrameTime = time;

        // Teardown Skill Rule: 25s of quiet activates gentle ambient orbit drift
        if (!this.isTouring && !this.isDragging && Date.now() - this.lastInteractionTime > 25000) {
          this.targetYaw += 0.0015;
        }

        this.render(time * 0.001);
        this.animFrameId = requestAnimationFrame(loop);
      };
      this.animFrameId = requestAnimationFrame(loop);
    }

    public destroy(): void {
      if (this.animFrameId) {
        cancelAnimationFrame(this.animFrameId);
        this.animFrameId = null;
      }
      this.stopAutoTour();
    }

    private project(
      x: number,
      y: number,
      z: number,
      cx: number,
      cy: number
    ): { x: number; y: number; z: number; scale: number } {
      const cosY = Math.cos(this.yaw);
      const sinY = Math.sin(this.yaw);
      const cosP = Math.cos(this.pitch);
      const sinP = Math.sin(this.pitch);

      // 1. Yaw rotation (around vertical Z axis)
      const rx = x * cosY - y * sinY;
      const ry = x * sinY + y * cosY;

      // 2. Pitch rotation (tilt angle)
      const ry2 = ry * cosP - z * sinP;
      const rz2 = ry * sinP + z * cosP;

      // 3. True Perspective division:
      // Camera sits at +effFov looking at origin.
      // Points closer to viewer (positive rz2) have smaller cameraDistance, hence LARGER scale!
      const effFov = this.fov * this.zoom;
      const cameraDist = effFov - rz2;
      const scale = cameraDist > 25 ? effFov / cameraDist : effFov / 25;

      return {
        x: cx + rx * scale,
        y: cy + ry2 * scale,
        z: rz2,
        scale,
      };
    }

    private render(t: number): void {
      const ctx = this.ctx;
      const w = this.canvas.width;
      const h = this.canvas.height;

      // Smooth physics damping toward targets
      this.pitch += (this.targetPitch - this.pitch) * 0.09;
      this.yaw += (this.targetYaw - this.yaw) * 0.09;
      this.zoom += (this.targetZoom - this.zoom) * 0.09;
      this.explodeProgress += (this.targetExplodeProgress - this.explodeProgress) * 0.09;

      // Update elevation gauge display
      const totalElevation = (this.explodeProgress * 320.0).toFixed(1);
      const elevGauge = document.getElementById('elevation-gauge');
      if (elevGauge) {
        elevGauge.textContent = `Meru Elevation: ${totalElevation} mm`;
      }

      ctx.save();
      ctx.scale(this.dpr, this.dpr);

      const renderW = w / this.dpr;
      const renderH = h / this.dpr;
      const cx = renderW * 0.5;

      // Dynamic viewport plane anchor:
      // In Top View (pitch ~ 0), plane is dead center (0.50).
      // In 3D (pitch > 0), base shifts smoothly down so apex has comfortable headroom.
      const pitchSin = Math.sin(this.pitch);
      const cy = renderH * 0.50 + pitchSin * (renderH * 0.10 + this.explodeProgress * 16);
      const baseR = Math.min(renderW, renderH) * 0.32;

      // Clear with elegant studio gradient (light canvas conforming to DESIGN.md)
      const bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, renderW * 0.7);
      bgGrad.addColorStop(0, '#ffffff');
      bgGrad.addColorStop(0.65, '#fafaf7');
      bgGrad.addColorStop(1, '#f2f1ec');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, renderW, renderH);

      // Subtle warm grid ground floor
      this.renderGroundGrid(ctx, cx, cy, baseR * 1.6);

      // Render vertical elevator leader lines when exploded
      if (this.explodeProgress > 0.08) {
        this.renderElevatorHairlines(ctx, cx, cy, baseR);
      }

      // Depth sort layers from back to front (Painter's Algorithm)
      // Ensures crisp, correct visual layering whether viewed from Top View, Top-Side, Bottom-Side, or Elevation
      const sortedLayers = LAYERS.map(layer => {
        const layerZ = layer.baseZ * (0.15 + this.explodeProgress * 2.8);
        const depth = layerZ * Math.cos(this.pitch);
        return { layer, layerZ, depth };
      }).sort((a, b) => a.depth - b.depth);

      for (const item of sortedLayers) {
        const isIsolated = this.isolatedLayer !== null && this.isolatedLayer === item.layer.id;
        const isDimmed = this.isolatedLayer !== null && this.isolatedLayer !== item.layer.id;
        this.renderLayerGeometry(ctx, item.layer, item.layerZ, cx, cy, baseR, isIsolated, isDimmed, t);
      }

      ctx.restore();
    }

    private renderGroundGrid(ctx: CanvasRenderingContext2D, cx: number, cy: number, size: number): void {
      ctx.save();
      ctx.strokeStyle = '#e6e5e0';
      ctx.lineWidth = 0.5;

      const steps = 10;
      const half = size;
      const zFloor = -6;

      for (let i = -steps; i <= steps; i++) {
        const x = (i / steps) * half;
        const p1 = this.project(x, -half, zFloor, cx, cy);
        const p2 = this.project(x, half, zFloor, cx, cy);

        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();

        const p3 = this.project(-half, x, zFloor, cx, cy);
        const p4 = this.project(half, x, zFloor, cx, cy);

        ctx.beginPath();
        ctx.moveTo(p3.x, p3.y);
        ctx.lineTo(p4.x, p4.y);
        ctx.stroke();
      }
      ctx.restore();
    }

    private renderElevatorHairlines(ctx: CanvasRenderingContext2D, cx: number, cy: number, baseR: number): void {
      ctx.save();
      ctx.strokeStyle = 'rgba(245, 78, 0, 0.18)'; // Subtle Cursor Orange hairlines
      ctx.lineWidth = 0.75;
      ctx.setLineDash([3, 4]);

      // Draw 4 corner vertical guideline pillars from base to top
      const corners = [
        { x: baseR * 0.95, y: baseR * 0.95 },
        { x: -baseR * 0.95, y: baseR * 0.95 },
        { x: -baseR * 0.95, y: -baseR * 0.95 },
        { x: baseR * 0.95, y: -baseR * 0.95 },
      ];

      const maxZ = LAYERS[8].baseZ * (0.15 + this.explodeProgress * 2.8);

      for (const pt of corners) {
        const pBottom = this.project(pt.x, pt.y, 0, cx, cy);
        const pTop = this.project(pt.x, pt.y, maxZ, cx, cy);

        ctx.beginPath();
        ctx.moveTo(pBottom.x, pBottom.y);
        ctx.lineTo(pTop.x, pTop.y);
        ctx.stroke();
      }
      ctx.restore();
    }

    private renderLayerGeometry(
      ctx: CanvasRenderingContext2D,
      layer: LayerData,
      z: number,
      cx: number,
      cy: number,
      baseR: number,
      isIsolated: boolean,
      isDimmed: boolean,
      t: number
    ): void {
      ctx.save();

      const alpha = isDimmed ? 0.14 : (isIsolated ? 1.0 : 0.85);
      const strokeColor = isIsolated ? '#f54e00' : (isDimmed ? '#a09c92' : layer.color);
      const lineWidth = isIsolated ? 2.0 : (isDimmed ? 0.6 : 1.1);

      ctx.strokeStyle = strokeColor;
      ctx.fillStyle = isIsolated ? 'rgba(245, 78, 0, 0.05)' : 'rgba(200, 150, 75, 0.02)';
      ctx.lineWidth = lineWidth;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (isIsolated) {
        ctx.shadowColor = 'rgba(245, 78, 0, 0.35)';
        ctx.shadowBlur = 10;
      }

      // Draw specific geometry for each Avarana
      switch (layer.id) {
        case 1: // Bhupura (Earth Citadel with 4 T-Gates)
          this.drawBhupura(ctx, z, cx, cy, baseR * 0.95, alpha);
          break;
        case 2: // 16-Petal Lotus
          this.drawLotus(ctx, 16, z, cx, cy, baseR * 0.78, baseR * 0.66, alpha);
          break;
        case 3: // 8-Petal Lotus
          this.drawLotus(ctx, 8, z, cx, cy, baseR * 0.62, baseR * 0.50, alpha);
          break;
        case 4: // 14 Triangles (Chaturdasha Kona)
          this.drawTriangleRing(ctx, 14, z, cx, cy, baseR * 0.48, baseR * 0.38, alpha);
          break;
        case 5: // Outer 10 Triangles (Bahir Dashara)
          this.drawTriangleRing(ctx, 10, z, cx, cy, baseR * 0.37, baseR * 0.28, alpha);
          break;
        case 6: // Inner 10 Triangles (Antar Dashara)
          this.drawTriangleRing(ctx, 10, z, cx, cy, baseR * 0.27, baseR * 0.19, alpha);
          break;
        case 7: // 8 Triangles (Ashta Kona)
          this.drawTriangleRing(ctx, 8, z, cx, cy, baseR * 0.18, baseR * 0.12, alpha);
          break;
        case 8: // Inmost Triangle (Trikona)
          this.drawCentralTrikona(ctx, z, cx, cy, baseR * 0.11, alpha);
          break;
        case 9: // Bindu Singularity
          this.drawBinduPoint(ctx, z, cx, cy, baseR, isIsolated, t);
          break;
      }

      ctx.restore();
    }

    private drawBhupura(
      ctx: CanvasRenderingContext2D,
      z: number,
      cx: number,
      cy: number,
      size: number,
      alpha: number
    ): void {
      ctx.globalAlpha = alpha;
      const tiers = [size, size * 0.94, size * 0.88];

      for (let idx = 0; idx < tiers.length; idx++) {
        const s = tiers[idx];
        const gW = s * 0.24; // Gate width
        const gD = s * 0.14; // Gate depth

        const pts = [
          // Top edge with North Gate
          { x: -s, y: -s },
          { x: -gW, y: -s },
          { x: -gW, y: -s - gD },
          { x: gW, y: -s - gD },
          { x: gW, y: -s },
          { x: s, y: -s },

          // Right edge with East Gate
          { x: s, y: -gW },
          { x: s + gD, y: -gW },
          { x: s + gD, y: gW },
          { x: s, y: gW },
          { x: s, y: s },

          // Bottom edge with South Gate
          { x: gW, y: s },
          { x: gW, y: s + gD },
          { x: -gW, y: s + gD },
          { x: -gW, y: s },
          { x: -s, y: s },

          // Left edge with West Gate
          { x: -s, y: gW },
          { x: -s - gD, y: gW },
          { x: -s - gD, y: -gW },
          { x: -s, y: -gW },
        ];

        ctx.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const p = this.project(pts[i].x, pts[i].y, z + idx * 2, cx, cy);
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.closePath();
        ctx.stroke();
      }
    }

    private drawLotus(
      ctx: CanvasRenderingContext2D,
      petals: number,
      z: number,
      cx: number,
      cy: number,
      rOuter: number,
      rInner: number,
      alpha: number
    ): void {
      ctx.globalAlpha = alpha;
      const angleStep = (Math.PI * 2) / petals;

      // Base ring
      const ringSteps = 48;
      ctx.beginPath();
      for (let i = 0; i <= ringSteps; i++) {
        const a = (i / ringSteps) * Math.PI * 2;
        const p = this.project(Math.cos(a) * rInner, Math.sin(a) * rInner, z, cx, cy);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();

      // Petals
      for (let i = 0; i < petals; i++) {
        const a1 = i * angleStep;
        const a2 = (i + 1) * angleStep;
        const aMid = (a1 + a2) * 0.5;

        const pBase1 = this.project(Math.cos(a1) * rInner, Math.sin(a1) * rInner, z, cx, cy);
        const pTip = this.project(Math.cos(aMid) * rOuter, Math.sin(aMid) * rOuter, z + 2, cx, cy);
        const pBase2 = this.project(Math.cos(a2) * rInner, Math.sin(a2) * rInner, z, cx, cy);

        ctx.beginPath();
        ctx.moveTo(pBase1.x, pBase1.y);
        ctx.lineTo(pTip.x, pTip.y);
        ctx.lineTo(pBase2.x, pBase2.y);
        ctx.stroke();
      }
    }

    private drawTriangleRing(
      ctx: CanvasRenderingContext2D,
      count: number,
      z: number,
      cx: number,
      cy: number,
      rOuter: number,
      rInner: number,
      alpha: number
    ): void {
      ctx.globalAlpha = alpha;
      const step = (Math.PI * 2) / count;

      for (let i = 0; i < count; i++) {
        const a1 = i * step;
        const a2 = (i + 1) * step;
        const aMid = (a1 + a2) * 0.5;

        const p1 = this.project(Math.cos(a1) * rInner, Math.sin(a1) * rInner, z, cx, cy);
        const pTip = this.project(Math.cos(aMid) * rOuter, Math.sin(aMid) * rOuter, z + 2, cx, cy);
        const p2 = this.project(Math.cos(a2) * rInner, Math.sin(a2) * rInner, z, cx, cy);

        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(pTip.x, pTip.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.closePath();
        ctx.stroke();
      }
    }

    private drawCentralTrikona(
      ctx: CanvasRenderingContext2D,
      z: number,
      cx: number,
      cy: number,
      r: number,
      alpha: number
    ): void {
      ctx.globalAlpha = alpha;
      // Downward-pointing primary Shakti triangle
      const pts = [
        { x: 0, y: r * 1.15 },                       // Apex pointing downward
        { x: Math.cos(-Math.PI / 6) * r, y: -r * 0.65 }, // Top-Right
        { x: Math.cos(-Math.PI * 5 / 6) * r, y: -r * 0.65 }, // Top-Left
      ];

      ctx.beginPath();
      for (let i = 0; i < pts.length; i++) {
        const p = this.project(pts[i].x, pts[i].y, z, cx, cy);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
    }

    private drawBinduPoint(
      ctx: CanvasRenderingContext2D,
      z: number,
      cx: number,
      cy: number,
      baseR: number,
      isIsolated: boolean,
      t: number
    ): void {
      const p = this.project(0, 0, z, cx, cy);
      const rad = baseR * (isIsolated ? 0.024 : 0.016) * p.scale;

      ctx.save();
      ctx.globalAlpha = 1.0;

      // Radiant halo
      const grad = ctx.createRadialGradient(p.x, p.y, 1, p.x, p.y, rad * 3.5);
      grad.addColorStop(0, 'rgba(245, 78, 0, 0.95)');
      grad.addColorStop(0.4, 'rgba(245, 140, 40, 0.45)');
      grad.addColorStop(1, 'rgba(245, 78, 0, 0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(p.x, p.y, rad * 3.5, 0, Math.PI * 2);
      ctx.fill();

      // Pulsing center pearl
      const pulse = Math.sin(t * 3.0) * 0.2 + 1.0;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(p.x, p.y, rad * pulse, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = '#f54e00';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();
    }
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    try {
      new TeardownSimulator();
    } catch (err) {
      console.warn('[Teardown Simulator] Init error:', err);
    }
  });
</script>

<style>
