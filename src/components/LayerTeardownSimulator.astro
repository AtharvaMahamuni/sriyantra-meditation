            <button class="cam-btn active" data-cam="isometric" title="3D Isometric 3/4 View">Isometric</button>
            <button class="cam-btn" data-cam="cutaway" title="Side Profile Elevation">Elevation</button>
            <button class="cam-btn" data-cam="bindu" title="Macro Bindu Focus">Apex Bindu</button>
            <button class="cam-btn reset" id="sim-reset-cam-btn" title="Reset Camera">Reset</button>
