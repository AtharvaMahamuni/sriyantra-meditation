---
import { url } from '../lib/site';

interface Props {
  isDark?: boolean;
}

const { isDark = false } = Astro.props;
---

<header class={`site-header ${isDark ? 'dark-mode' : 'light-mode'}`}>
  <div class="header-inner">
    <a href={url("/")} class="brand-link" aria-label="Sri Yantra Meditation Home">
      <div class="brand-symbol">
        <svg viewBox="0 0 40 40" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
          <polygon points="20,6 34,30 6,30" stroke="currentColor" stroke-width="1.2"/>
          <polygon points="20,34 34,10 6,10" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="20" cy="20" r="2.5" fill="#f54e00"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">Sri Yantra</span>
        <span class="brand-sub">Meditation & Sacred Geometry</span>
      </div>
    </a>

    <nav class="nav-links" aria-label="Main Navigation">
      <a href={url("/")} class="nav-link">Visualizer</a>
      <a href={url("/#layers-explorer")} class="nav-link">3D Layers</a>
      <a href={url("/geometry/")} class="nav-link">Geometry</a>
      <a href={url("/meditation/")} class="nav-link">Meditation</a>
      <a href={url("/vastu/")} class="nav-link">Vastu & Placement</a>
      <a href={url("/materials/")} class="nav-link">Materials & Sphatik</a>
      <a href={url("/faq/")} class="nav-link">FAQ</a>
    </nav>

    <div class="header-actions">
      <a href={url("/")} class="launch-btn">
        <span class="btn-dot"></span>
        <span>Enter Meditation</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    z-index: 50;
    transition: background-color var(--duration-normal) var(--ease-calm);
  }

  .light-mode {
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
  }

  .dark-mode {
    background-color: rgba(18, 17, 15, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-zen-ink);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-symbol {
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .brand-sub {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dark-mode .brand-sub {
    color: var(--color-zen-body);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 820px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.875rem;
    color: inherit;
    opacity: 0.8;
    transition: opacity var(--duration-normal) var(--ease-calm), color var(--duration-normal) var(--ease-calm);
  }

  .nav-link:hover {
    opacity: 1;
    color: var(--color-primary);
  }

  .launch-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    background-color: var(--color-primary);
    color: #ffffff;
    transition: background-color var(--duration-normal) var(--ease-calm), transform var(--duration-normal) var(--ease-calm);
  }

  .launch-btn:hover {
    background-color: var(--color-primary-active);
    transform: translateY(-1px);
  }

  .btn-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
    animation: pulse-dot 2.5s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }
</style>
