---
---

<div id="zen-dock-container" class="zen-dock-container">
  <div class="zen-dock">
    <!-- Row 1: Primary Meditative Controls -->
    <div class="dock-row primary-row">
      <!-- Atmosphere Selector -->
      <div class="control-group">
        <span class="control-label">Scene</span>
        <div class="pill-selector" id="scene-selector" role="radiogroup" aria-label="Background Atmosphere">
          <button class="pill-btn active" data-scene="galaxy" title="Cosmic Galaxy 3D">Galaxy</button>
          <button class="pill-btn" data-scene="divine-light" title="Volumetric Divine Rays">Divine</button>
          <button class="pill-btn" data-scene="quantum-atoms" title="Quantum Prana Nodes">Atoms</button>
          <button class="pill-btn" data-scene="zen-void" title="Pure Obsidian Void">Void</button>
        </div>
      </div>

      <div class="dock-divider"></div>

      <!-- Color Palette Selector -->
      <div class="control-group">
        <span class="control-label">Colors</span>
        <div class="pill-selector" id="palette-selector" role="radiogroup" aria-label="Color Palette">
          <button class="pill-btn active" data-palette="cursor-gold" title="Vedic Solar Gold & Cursor Vermilion">Gold</button>
          <button class="pill-btn" data-palette="amethyst-rose" title="Sacred Amethyst & Rose Shimmer">Amethyst</button>
          <button class="pill-btn" data-palette="emerald-copper" title="Celestial Jade & Copper Fire">Emerald</button>
          <button class="pill-btn" data-palette="pure-platinum" title="Brilliant Platinum & Moonlight Silver">Platinum</button>
        </div>
      </div>

      <div class="dock-divider"></div>

      <!-- Sound Synthesizer Selector -->
      <div class="control-group">
        <span class="control-label">Sound</span>
        <div class="pill-selector" id="sound-selector" role="radiogroup" aria-label="Sound Mode">
          <button class="pill-btn active" data-sound="om-136" title="136.1 Hz Cosmic Om Drone">136Hz</button>
          <button class="pill-btn" data-sound="om-tanpura" title="Om with Tanpura Shimmer">Tanpura</button>
          <button class="pill-btn" data-sound="singing-bowl" title="Tibetan Singing Bowl Bell">Bowl</button>
          <button class="pill-btn" data-sound="mute" title="Mute Audio">Mute</button>
        </div>
      </div>
    </div>

    <!-- Row 2: Motion, Speed, Mantra & Utilities -->
    <div class="dock-row secondary-row">
      <!-- Motion Style Selector -->
      <div class="control-group">
        <span class="control-label">Motion</span>
        <div class="pill-selector" id="motion-selector" role="radiogroup" aria-label="Motion Style">
          <button class="pill-btn active" data-motion="alternating" title="Concentric layers counter-rotate gracefully; 9 triangles stay crystalline">Alternate</button>
          <button class="pill-btn" data-motion="unified" title="All layers rotate synchronously">Unified</button>
          <button class="pill-btn" data-motion="still" title="Complete stillness for pure Bindu Trataka gaze">Still</button>
        </div>
      </div>

      <!-- Speed Control -->
      <div class="control-group">
        <span class="control-label">Speed</span>
        <div class="pill-selector" id="speed-selector" role="radiogroup" aria-label="Rotation Speed">
          <button class="pill-btn" data-speed="0.5" title="Gentle Slow Drift">0.5x</button>
          <button class="pill-btn active" data-speed="1.0" title="Standard Meditative Pace">1.0x</button>
          <button class="pill-btn" data-speed="1.8" title="Dynamic Celestial Flow">1.8x</button>
        </div>
      </div>

      <div class="dock-divider"></div>

      <!-- Glowing Mantra Selector -->
      <div class="control-group">
        <span class="control-label">Mantra</span>
        <div class="pill-selector" id="mantra-selector" role="radiogroup" aria-label="Glowing Mantra Overlay">
          <button class="pill-btn active" data-mantra="om" title="Primordial Om ॐ">ॐ</button>
          <button class="pill-btn" data-mantra="shreem" title="Abundance Seed Shreem श्रीं">श्रीं</button>
          <button class="pill-btn" data-mantra="sri-matre" title="Maha Mantra ॐ ऐं ह्रीं श्रीं">Maha</button>
          <button class="pill-btn" data-mantra="off" title="No Text Overlay">Off</button>
        </div>
      </div>

      <div class="dock-divider"></div>

      <!-- Session & Utility Actions -->
      <div class="dock-actions">
        <!-- Screen Wake Lock Toggle -->
        <button id="wakelock-btn" class="action-icon-btn active" title="Screen Wake Lock: Keeps Screen Awake During Meditation">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <span class="status-indicator"></span>
        </button>

        <!-- 4K Wallpaper Download -->
        <button id="download-wallpaper-btn" class="action-icon-btn" title="Download High-Res 4K Sri Yantra Wallpaper">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </button>

        <!-- Fullscreen Toggle -->
        <button id="fullscreen-btn" class="action-icon-btn" title="Toggle Fullscreen Immersion (Hides Cursor & Scrollbar)">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .zen-dock-container {
    position: fixed;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
    pointer-events: auto;
  }

  .zen-dock-container.idle-hidden {
    opacity: 0;
    transform: translateX(-50%) translateY(18px);
    pointer-events: none;
  }

  .zen-dock {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.65rem 0.95rem;
    border-radius: 20px;
    background-color: rgba(18, 17, 15, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
  }

  .dock-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .zen-dock-container {
      bottom: 0.75rem;
      width: calc(100% - 1.5rem);
      max-width: 480px;
    }
    .zen-dock {
      padding: 0.6rem;
      gap: 0.45rem;
    }
    .dock-row {
      gap: 0.4rem;
    }
    .dock-divider {
      display: none;
    }
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .control-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-zen-body);
  }

  .pill-selector {
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    padding: 2px;
  }

  .pill-btn {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-zen-body);
    padding: 0.22rem 0.55rem;
    border-radius: 9999px;
    transition: all 0.2s var(--ease-calm);
    white-space: nowrap;
  }

  .pill-btn:hover {
    color: #ffffff;
  }

  .pill-btn.active {
    background-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 0 10px rgba(245, 78, 0, 0.4);
  }

  .dock-divider {
    width: 1px;
    height: 16px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  .dock-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .action-icon-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-zen-body);
    background-color: rgba(255, 255, 255, 0.06);
    position: relative;
    transition: all 0.2s var(--ease-calm);
  }

  .action-icon-btn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.14);
  }

  .action-icon-btn.active {
    color: var(--color-primary);
  }

  .status-indicator {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #2ed573;
    box-shadow: 0 0 6px #2ed573;
  }
</style>
