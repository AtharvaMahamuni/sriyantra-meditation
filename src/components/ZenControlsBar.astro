---
---

<div id="zen-dock-container" class="zen-dock-container">
  <div class="zen-dock">
    <!-- Atmosphere / Scene Dropdown -->
    <div class="dock-select-group">
      <label for="select-scene" class="select-label">Scene</label>
      <div class="select-wrapper">
        <select id="select-scene" class="zen-select" aria-label="Select Background Atmosphere">
          <option value="galaxy" selected>Cosmic Galaxy</option>
          <option value="divine-light">Divine Rays</option>
          <option value="quantum-atoms">Quantum Atoms</option>
          <option value="zen-void">Pure Void</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Sacred Mantra Acoustic Chime Dropdown -->
    <div class="dock-select-group">
      <label for="select-mantra" class="select-label">Acoustics</label>
      <div class="select-wrapper">
        <select id="select-mantra" class="zen-select" aria-label="Select Sacred Acoustic Chime">
          <option value="om" selected>ॐ Om • 136.1 Hz Tibetan Bowl</option>
          <option value="shreem">श्रीं Shreem • 432 Hz Crystal Bowl</option>
          <option value="sri-matre">Maha Chime • 528 Hz Temple Triad</option>
          <option value="off">Mantra Chime Off</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Sound Mode Dropdown -->
    <div class="dock-select-group">
      <label for="select-sound" class="select-label">Sound</label>
      <div class="select-wrapper">
        <select id="select-sound" class="zen-select" aria-label="Select Sound Mode">
          <option value="om-136" selected>136.1 Hz Cosmic Om</option>
          <option value="om-tanpura">Om + Tanpura Shimmer</option>
          <option value="singing-bowl">Tibetan Singing Bowl</option>
          <option value="mute">Mute (Silent)</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Color Palette Dropdown -->
    <div class="dock-select-group">
      <label for="select-palette" class="select-label">Palette</label>
      <div class="select-wrapper">
        <select id="select-palette" class="zen-select" aria-label="Select Color Palette">
          <option value="cursor-gold" selected>Solar Gold</option>
          <option value="amethyst-rose">Amethyst Rose</option>
          <option value="emerald-copper">Emerald Copper</option>
          <option value="pure-platinum">Moonlight Platinum</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Motion Style Dropdown -->
    <div class="dock-select-group">
      <label for="select-motion" class="select-label">Motion</label>
      <div class="select-wrapper">
        <select id="select-motion" class="zen-select" aria-label="Select Motion Style">
          <option value="alternating" selected>Alternate Layers</option>
          <option value="unified">Unified Rotation</option>
          <option value="still">Still (Trataka Gaze)</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Rotation Speed Dropdown -->
    <div class="dock-select-group">
      <label for="select-speed" class="select-label">Speed</label>
      <div class="select-wrapper">
        <select id="select-speed" class="zen-select" aria-label="Select Rotation Speed">
          <option value="0.5">0.5x Slow</option>
          <option value="1.0" selected>1.0x Normal</option>
          <option value="1.8">1.8x Fast</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="dock-divider"></div>

    <!-- Quick Utility Actions -->
    <div class="dock-actions">
      <!-- Show / Hide Sri Yantra Toggle -->
      <button id="toggle-yantra-btn" class="action-icon-btn active" title="Show or Hide Sri Yantra Sacred Geometry" aria-label="Toggle Sri Yantra Geometry">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 3 2 21 22 21"/>
        </svg>
      </button>

      <!-- Screen Wake Lock Toggle -->
      <button id="wakelock-btn" class="action-icon-btn active" title="Keep Screen Awake During Meditation" aria-label="Toggle Screen Wake Lock">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <span class="status-indicator"></span>
      </button>

      <!-- 4K Wallpaper Download -->
      <button id="download-wallpaper-btn" class="action-icon-btn" title="Download High-Res 4K Sri Yantra Wallpaper" aria-label="Download Wallpaper">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </button>

      <!-- Fullscreen Toggle -->
      <button id="fullscreen-btn" class="action-icon-btn" title="Toggle Fullscreen Immersion" aria-label="Toggle Fullscreen">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .zen-dock-container {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
    pointer-events: auto;
    max-width: 95vw;
  }

  .zen-dock-container.idle-hidden {
    opacity: 0;
    transform: translateX(-50%) translateY(16px);
    pointer-events: none;
  }

  .zen-dock {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.85rem;
    border-radius: 9999px;
    background-color: rgba(18, 17, 15, 0.86);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .zen-dock::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 980px) {
    .zen-dock-container {
      bottom: 0.85rem;
      width: calc(100% - 1.5rem);
    }
    .zen-dock {
      border-radius: 20px;
      flex-wrap: wrap;
      justify-content: center;
      padding: 0.55rem;
      gap: 0.45rem;
    }
    .dock-divider {
      display: none;
    }
  }

  .dock-select-group {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .select-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-zen-body);
    white-space: nowrap;
  }

  .select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .zen-select {
    appearance: none;
    -webkit-appearance: none;
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-zen-ink);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.28rem 1.65rem 0.28rem 0.65rem;
    font-size: 0.6875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease-calm);
    white-space: nowrap;
  }

  .zen-select:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(245, 78, 0, 0.45);
    color: #ffffff;
  }

  .zen-select:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(245, 78, 0, 0.3);
  }

  .zen-select option {
    background-color: #1a1815;
    color: #f7f7f4;
    padding: 0.45rem;
  }

  .select-arrow {
    position: absolute;
    right: 0.55rem;
    pointer-events: none;
    color: var(--color-zen-body);
    transition: color 0.2s ease;
  }

  .select-wrapper:hover .select-arrow {
    color: var(--color-primary);
  }

  .dock-divider {
    width: 1px;
    height: 18px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 0 0.15rem;
  }

  .dock-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .action-icon-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-zen-body);
    background-color: rgba(255, 255, 255, 0.06);
    position: relative;
    transition: all 0.2s var(--ease-calm);
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .action-icon-btn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(245, 78, 0, 0.4);
  }

  .action-icon-btn.active {
    color: var(--color-primary);
    border-color: rgba(245, 78, 0, 0.35);
  }

  .status-indicator {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #2ed573;
    box-shadow: 0 0 6px #2ed573;
  }
</style>
